# Template for compose.yml. Copy this file to `.env` (untracked -- see
# .gitignore) and fill in real values there. Docker Compose reads a file
# literally named `.env` from the project directory automatically; it does
# NOT read `.env.example`, so editing this file has no effect on a running
# stack.
#
#   cp .env.example .env
#
# Never put real credentials in this file -- it is committed. `.env` is not.

# --- Database ------------------------------------------------------------
# JDBC URL without the jdbc: prefix (compose.yml's realty-rest service
# prepends it), e.g. mariadb://db-host:3306/realty. Also used by the bundled
# `mariadb` service below to name the database it creates on first start.
REALTY_DB_URL=mariadb://mariadb:3306/realty
REALTY_DB_USERNAME=realty
REALTY_DB_PASSWORD=change-me
# Only read by the bundled `mariadb` service (MARIADB_ROOT_PASSWORD). Unused
# if you point REALTY_DB_URL at a database you don't manage from this stack.
REALTY_DB_ROOT_PASSWORD=change-me

# --- Query-service module (optional) --------------------------------------
# Leave both blank to disable enrichment -- dimensions and player names in
# responses degrade to null. If set, REALTY_REST_MODULE_SECRET must match
# the value in the module's own config.yml on the game server.
REALTY_REST_MODULE_URL=
REALTY_REST_MODULE_SECRET=
